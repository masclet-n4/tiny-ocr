# Puerto publicado por Docker Compose
OCR_PORT=3000

# URLs desde el contenedor OCR hacia servicios que corren en el host
PB_URL=http://host.docker.internal:8090
RUSTFS_ENDPOINT=http://host.docker.internal:9000

# Si ejecutas la API directamente en el host, usa localhost en esas URLs.

# Renderizado PDF y motor OCR
OCR_RENDER_SCALE=1.5
OCR_MEMORY_TRIM=1
TESSERACT_LANG=spa+eng
TESSERACT_PSM=3
OCR_ISOLATE_PROCESS=1

# Almacenamiento de resultados en RustFS
RUSTFS_BUCKET=ocr-results
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=change-me
RUSTFS_REGION=us-east-1
